  "nodes": [
    {
      "id": "file:src/Modules/Modules.cpp",
      "type": "file",
      "name": "Modules.cpp",
      "filePath": "src/Modules/Modules.cpp",
      "summary": "全局单例中枢实现，持有所有子模块实例，按依赖顺序统一调用各模块的build/destroy/start/stop生命周期，在connect()中完成所有跨模块Qt信号槽连接，并提供运行环境检查。",
      "tags": ["singleton", "orchestration", "module", "lifecycle", "qt-signal-slot"],
      "complexity": "complex",
      "languageNotes": "build/start/stop方法按固定顺序遍历模块列表调用同名方法，connect方法包含十余个QObject::connect跨模块信号槽绑定。"
    },
    {
      "id": "file:src/Modules/PlcController.cpp",
      "type": "file",
      "name": "PlcController.cpp",
      "filePath": "src/Modules/PlcController.cpp",
      "summary": "PLC控制器模块实现，管理Modbus设备（PLC）的连接与调度器，从配置文件读取IP/端口，创建后台监听线程轮询寄存器值。",
      "tags": ["plc", "modbus", "module", "threading", "configuration"],
      "complexity": "moderate",
      "languageNotes": "loadConfigFromFile函数从桌面路径下的配置文件解析IP和端口，使用Windows SHGetFolderPathW API获取桌面路径。"
    },
    {
      "id": "file:src/Modules/ReconnectModule.cpp",
      "type": "file",
      "name": "ReconnectModule.cpp",
      "filePath": "src/Modules/ReconnectModule.cpp",
      "summary": "重连模块实现，创建CameraAndCardStateThread后台线程，监控相机和板卡连接状态并在断连时触发设备重连。",
      "tags": ["reconnection", "monitoring", "module", "threading"],
      "complexity": "simple"
    },
    {
      "id": "file:src/Modules/RuntimeInfoModule.cpp",
      "type": "file",
      "name": "RuntimeInfoModule.cpp",
      "filePath": "src/Modules/RuntimeInfoModule.cpp",
      "summary": "运行时信息模块实现，创建DetachUtiltyThread后台线程用于轮询PLC信息和统计数据，追踪系统运行状态。",
      "tags": ["runtime", "statistics", "module", "threading"],
      "complexity": "simple"
    },
    {
      "id": "file:src/Modules/TestModule.cpp",
