  "nodes": [
    {
      "id": "file:include/Modules/ConfigManagerModule.hpp",
      "type": "file",
      "name": "ConfigManagerModule.hpp",
      "filePath": "include/Modules/ConfigManagerModule.hpp",
      "summary": "配置管理模块头文件，定义 ConfigManagerModule 类及 loadConfigSafe 模板方法，实现版本兼容的 XML 配置文件加载与自动合并。",
      "tags": ["configuration", "serialization", "template", "module-interface"],
      "complexity": "moderate",
      "languageNotes": "loadConfigSafe 模板函数利用 SFINAE 和异常捕获实现配置文件版本兼容合并，是配置系统的核心模式。"
    },
    {
      "id": "file:include/Modules/ImgProModule.hpp",
