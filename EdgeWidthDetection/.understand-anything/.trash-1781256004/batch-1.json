      "tags": ["camera", "hardware-abstraction", "frame-capture", "qt-signals"],
      "complexity": "moderate",
      "languageNotes": "使用 std::vector<BuildError> 作为 IModule 模板参数，支持按相机分别报告构建错误。"
    },
