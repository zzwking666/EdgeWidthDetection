  "layers": [
    {"id":"layer:core-framework","name":"核心框架层","description":"IModule 生命周期接口模板和 Modules 全局单例中枢，定义所有模块的统一契约和全生命周期编排"},
    {"id":"layer:feature-modules","name":"功能模块层","description":"实现 IModule 接口的 10 个业务子模块：相机采集、配置管理、图像处理、图像保存、缺陷剔除、PLC 通信、重连监控、运行时信息、UI 管理、警告"},
    {"id":"layer:image-processing","name":"图像处理引擎层","description":"ImageProcessingModule 图像处理管线：预处理、模型引擎构建（ONNX/CUDA/TensorRT）和边缘宽度检测算法"},
    {"id":"layer:background-threads","name":"后台线程层","description":"4 个独立于 Qt 主事件循环的异步工作线程：PLC 监听、缺陷剔除判定、PLC 信息轮询、相机/板卡状态监控"},
    {"id":"layer:global-data","name":"全局数据层","description":"跨模块共享的数据结构和工具函数：GlobalPath、ModBusAddress、PlcReadIndex、配置转换工具"},
    {"id":"layer:ui-presentation","name":"UI 表现层","description":"Qt6 主窗口和产品设置对话框的声明、实现和 Qt Designer 生成的 .ui 布局文件"},
